<%- include('partials/head') %>

    <body class="bg-gray-200 min-h-screen flex items-center justify-center p-4">

        <div class="bg-white p-8 rounded-lg shadow-md border border-gray-300 max-w-md w-full">
            <div class="text-center mb-6">
                <h1 class="text-3xl font-extrabold text-blue-600">Crear Cuenta</h1>
                <p class="text-sm text-gray-500 mt-1">Registra tu usuario para solicitar soporte técnico</p>
            </div>

            <form action="/register" method="POST" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1" for="name">Nombre </label>
                    <input type="text" id="name" name="nombre"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-black bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Ej. Juan" required>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1" for="name">Apellidos </label>
                    <input type="text" id="lastname" name="apellido"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-black bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Ej. Martinez Pérez" required>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1" for="usuario">Usuario </label>
                    <input type="text" id="usuario" name="usuario"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-black bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Ej. JuanMartinez" required>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1" for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-black bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="correo@tickets.com" required>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1" for="password">Contraseña</label>
                    <input type="password" id="password" name="password"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-black bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Contraseña de la cuenta" required>
                </div>
                <div>
                    <input type="password" id="re-password" name="Re-password"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-black bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Contraseña nuevamente de la cuenta" required>
                </div>


                <button type="submit"
                    class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition duration-200">
                    📝 Registrarme
                </button>
            </form>

            <div class="text-center mt-4 text-sm text-gray-600">
                ¿Ya tienes una cuenta? <a href="/login" class="text-blue-500 hover:underline font-semibold">Inicia
                    sesión</a>
            </div>
        </div>

    </body>

    </html>