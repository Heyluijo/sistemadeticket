<%- include('../partials/head') %>

    <body class="bg-gray-100 flex h-screen font-sans">

        <div class="w-64 bg-slate-800 text-white flex flex-col">
            <div class="p-4 mt-2">
                <h1 class="text-xl font-bold text-blue-400">IT Tickets</h1>
                <p class="text-xs text-gray-400">Tarea de Soporte Técnico</p>
            </div>

            <div class="bg-slate-700 m-4 p-3 rounded">
                <p class="font-bold text-sm">Laura Gerente IT</p>
                <p class="text-blue-300 text-xs font-bold mt-1">[ GERENTE ]</p>
            </div>

            <div class="flex-1 px-4 mt-2">
                <div class="bg-slate-900 p-2 rounded mb-2 flex items-center font-bold text-sm text-white">
                    <span class="mr-2">📊</span> Métricas y Asignar
                </div>
            </div>

            <div class="p-4 mb-4">
                <%- include('../components/btnLogout.ejs') %>
            </div>
        </div>

        <div class="flex-1 p-8 overflow-y-auto">
            <div class="mb-6 border-b border-gray-300 pb-4">
                <h2 class="text-3xl font-bold text-gray-800 mb-1">Panel de Gerencia IT</h2>
                <p class="text-gray-500 text-sm">Revisión de métricas, rendimiento y asignación manual de soporte</p>
            </div>

            <div class="flex space-x-4 mb-6">
                <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm w-1/4">
                    <p class="text-xs text-gray-500 font-bold mb-2">TOTAL TICKETS</p>
                    <p class="text-3xl text-gray-800 font-bold">5</p>
                </div>

                <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm w-1/4">
                    <p class="text-xs text-yellow-500 font-bold mb-2">ABIERTOS</p>
                    <p class="text-3xl text-yellow-500 font-bold">3</p>
                </div>

                <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm w-1/4">
                    <p class="text-xs text-green-500 font-bold mb-2">SOLUCIONADOS</p>
                    <p class="text-3xl text-green-500 font-bold">2</p>
                </div>

                <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm w-1/4">
                    <p class="text-xs text-gray-800 font-bold mb-2">CERRADOS</p>
                    <p class="text-3xl text-gray-600 font-bold">0</p>
                </div>
            </div>

            <div class="flex space-x-6 mb-6">
                <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm w-1/2">
                    <div class="flex items-center mb-6">
                        <span class="text-xl mr-2">👥</span>
                        <h3 class="text-lg font-bold text-gray-800">Desempeño de Soporte</h3>
                    </div>

                    <div class="mb-6">
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-bold text-gray-800">Juan Soporte (Redes)</span>
                            <span class="text-gray-500 text-xs">2 asignados / 1 resueltos</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-1">
                            <div class="bg-blue-500 h-2.5 rounded-full" style="width: 33%"></div>
                        </div>
                        <div class="text-right text-[10px] text-gray-400">Tasa de resolución: 33%</div>
                    </div>

                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-bold text-gray-800">Maria Soporte (Software)</span>
                            <span class="text-gray-500 text-xs">1 asignados / 1 resueltos</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-1">
                            <div class="bg-blue-500 h-2.5 rounded-full" style="width: 50%"></div>
                        </div>
                        <div class="text-right text-[10px] text-gray-400">Tasa de resolución: 50%</div>
                    </div>
                </div>

                <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm w-1/2">
                    <div class="flex items-center mb-6">
                        <span class="text-xl mr-2">🏷️</span>
                        <h3 class="text-lg font-bold text-gray-800">Servicios por Categoría</h3>
                    </div>

                    <table class="w-full text-sm text-left border-collapse">
                        <thead>
                            <tr class="border-b border-gray-100">
                                <th class="py-2 text-xs text-gray-500 font-bold uppercase">CATEGORÍA</th>
                                <th class="py-2 text-xs text-gray-500 font-bold uppercase text-center">CREADOS</th>
                                <th class="py-2 text-xs text-gray-500 font-bold uppercase text-center">RESUELTOS</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <tr>
                                <td class="py-3 text-blue-600 font-bold text-xs">Redes y Telecomunicaciones</td>
                                <td class="py-3 text-center text-gray-800 font-bold text-xs">1</td>
                                <td class="py-3 text-center text-green-600 font-bold text-xs">1</td>
                            </tr>
                            <tr>
                                <td class="py-3 text-blue-600 font-bold text-xs">Hardware y Periféricos</td>
                                <td class="py-3 text-center text-gray-800 font-bold text-xs">1</td>
                                <td class="py-3 text-center text-green-600 font-bold text-xs">0</td>
                            </tr>
                            <tr>
                                <td class="py-3 text-blue-600 font-bold text-xs">Software y Aplicaciones</td>
                                <td class="py-3 text-center text-gray-800 font-bold text-xs">2</td>
                                <td class="py-3 text-center text-green-600 font-bold text-xs">1</td>
                            </tr>
                            <tr>
                                <td class="py-3 text-blue-600 font-bold text-xs">Otros / Consultas Generales</td>
                                <td class="py-3 text-center text-gray-800 font-bold text-xs">1</td>
                                <td class="py-3 text-center text-green-600 font-bold text-xs">0</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
                <div class="flex items-center mb-6">
                    <span class="text-xl mr-2">🎫</span>
                    <h3 class="text-lg font-bold text-gray-800">Supervisión de Casos</h3>
                </div>

                <table class="w-full border-collapse bg-gray-50 border border-gray-100 text-sm text-left">
                    <thead>
                        <tr>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                ID</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Solicitante</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                categoriaAsignada</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Descripcion</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                tecnico_automatico</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                tecnico_asignado_id</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                fecha_creacion</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                fecha_cierre</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                usuario_id</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                usuario</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                email</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Rol</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Ultimo Login</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white" id="ticketsAsignados">

                    </tbody>
                </table>
            </div>
        </div>

        <script defer>
            const ticketsAsignados = document.querySelector('#ticketsAsignados');
            const verTickets = async () => {
                fetch('/verTicketsAsignados')
                    .then(response => response.json())
                    .then(data => {
                        ticketsAsignados.innerHTML = "";
                        data.forEach(ticket => {
                            const fechaCreacion = new Date(ticket.fecha_creacion).toLocaleDateString('es-ES');
                            const fechaCierre = ticket.fecha_cierre ? new Date(ticket.fecha_cierre).toLocaleDateString('es-ES') : '-';
                            const ultimoLogin = ticket.ultimo_login ? new Date(ticket.ultimo_login).toLocaleDateString('es-ES') : '-';
                            const tecnicoAsignado = ticket.tecnico_asignado_id !== null ? ticket.tecnico_asignado_id : 'Sin asignar';
                            const tecnicoAutomatico = ticket.tecnico_automatico ? 'Sí' : 'No';

                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td class="border border-gray-200 px-4 py-3 font-bold text-gray-800 text-xs">${ticket.id}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-800 text-xs">${ticket.usuario}</td>
                                <td class="border border-gray-200 px-4 py-3 text-blue-600 font-bold text-xs">${ticket.nombre}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-800 text-xs font-bold">${ticket.descripcion}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${tecnicoAutomatico}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${tecnicoAsignado}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${fechaCreacion}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${fechaCierre}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-800 text-xs">${ticket.usuario_id}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-800 text-xs font-bold">${ticket.usuario}</td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${ticket.email}</td>
                                <td class="border border-gray-200 px-4 py-3 text-center">
                                    <span class="bg-blue-100 border border-blue-300 text-blue-700 px-2 py-1 rounded text-[10px] font-bold uppercase shadow-sm">${ticket.rol}</span>
                                </td>
                                <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${ultimoLogin}</td>
                            `;
                            ticketsAsignados.appendChild(tr);
                        });
                    })
                    .catch(err => console.error('Error al cargar tickets:', err));
            }

            verTickets();
        </script>
    </body>

    </html>