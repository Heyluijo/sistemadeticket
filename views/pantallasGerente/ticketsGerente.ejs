<%- include('../partials/head') %>

    <body class="bg-gray-100 flex h-screen font-sans">

        <% let homeUrl='/gestionDeTicket' ; if (user.rol==='Admin' ) homeUrl='/admin' ; else if (user.rol==='Gerente'
            ) homeUrl='/gerente' ; else if (user.rol==='Soporte' ) homeUrl='/soporte' ; %>
            <div class="w-64 bg-slate-800 text-white flex flex-col">
                <a href="<%= homeUrl %>" class="block p-4 mt-2 hover:bg-slate-700 transition rounded">
                <h1 class="text-xl font-bold text-blue-400">IT Tickets</h1>
                <p class="text-xs text-gray-400">Tarea de Soporte Técnico</p>
            </a>

            <div class="bg-slate-700 m-4 p-3 rounded">
                <p class="font-bold text-sm">
                    <%= user.nombre || '' %>
                        <%= user.apellido || '' %>
                </p>
                <p class="text-blue-300 text-xs font-bold mt-1">[ <%= user.rol.toUpperCase() %> ]</p>
            </div>

            <div class="flex-1 px-4 mt-2">
                <div class="bg-slate-900 p-2 rounded mb-2 flex items-center font-bold text-sm text-white">
                    <span class="mr-2">📊</span> Métricas y Asignar
                </div>
            </div>

            <div class="p-4 mb-4">
                <%- include('../components/btnLogout.ejs') %>
            </div>
        </div>

        <div class="flex-1 p-8 overflow-y-auto">
            <div class="mb-6 border-b border-gray-300 pb-4 flex items-start justify-between gap-6 flex-wrap">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800 mb-1">Panel de Gerencia IT</h2>
                    <p class="text-gray-500 text-sm">Revisión de métricas, rendimiento y asignación manual de soporte</p>
                </div>
                <div data-avatar-menu
                    class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold text-sm shrink-0 cursor-pointer"
                    title="<%= user.nombre %> <%= user.apellido %>">
                    <%= (user.nombre || '?').charAt(0).toUpperCase() %><%= (user.apellido || '?').charAt(0).toUpperCase() %>
                </div>
            </div>

            <div class="flex space-x-4 mb-6">
                <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm w-1/3">
                    <p class="text-xs text-gray-500 font-bold mb-2">TOTAL TICKETS</p>
                    <p class="text-3xl text-gray-800 font-bold">
                        <%= totalTickets %>
                    </p>
                </div>

                <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm w-1/3">
                    <p class="text-xs text-yellow-500 font-bold mb-2">ABIERTOS</p>
                    <p class="text-3xl text-yellow-500 font-bold">
                        <%= abiertos %>
                    </p>
                </div>

                <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm w-1/3">
                    <p class="text-xs text-green-500 font-bold mb-2">SOLUCIONADOS</p>
                    <p class="text-3xl text-green-500 font-bold">
                        <%= solucionados %>
                    </p>
                </div>
            </div>

            <div class="flex space-x-6 mb-6">
                <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm w-1/2">
                    <div class="flex items-center mb-6">
                        <span class="text-xl mr-2">👥</span>
                        <h3 class="text-lg font-bold text-gray-800">Desempeño de Soporte</h3>
                    </div>

                    <% if (desempeno.length===0) { %>
                        <p class="text-sm text-gray-400 italic">No hay técnicos de soporte registrados todavía.</p>
                        <% } else { %>
                            <% desempeno.forEach(function(tec) { %>
                                <% const tasa=tec.asignados> 0 ? Math.round((tec.resueltos / tec.asignados) * 100) : 0;
                                    %>
                                    <div class="mb-6">
                                        <div class="flex justify-between text-sm mb-1">
                                            <span class="font-bold text-gray-800">
                                                <%= tec.nombre %>
                                                    <%= tec.apellido %> (<%= tec.categoriaAsignada || 'Sin categoría'
                                                        %>)
                                            </span>
                                            <span class="text-gray-500 text-xs">
                                                <%= tec.asignados %> asignados / <%= tec.resueltos %> resueltos
                                            </span>
                                        </div>
                                        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-1">
                                            <div class="bg-blue-500 h-2.5 rounded-full" style="width: <%= tasa %>%">
                                            </div>
                                        </div>
                                        <div class="text-right text-[10px] text-gray-400">Tasa de resolución:
                                            <%= tasa %>%
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } %>
                </div>

                <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm w-1/2">
                    <div class="flex items-center mb-6">
                        <span class="text-xl mr-2">🏷️</span>
                        <h3 class="text-lg font-bold text-gray-800">Servicios por Categoría</h3>
                    </div>

                    <table class="w-full text-sm text-left border-collapse">
                        <thead>
                            <tr class="border-b border-gray-100">
                                <th class="py-2 text-xs text-gray-500 font-bold uppercase">CATEGORÍA</th>
                                <th class="py-2 text-xs text-gray-500 font-bold uppercase text-center">CREADOS</th>
                                <th class="py-2 text-xs text-gray-500 font-bold uppercase text-center">RESUELTOS</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% if (categorias.length===0) { %>
                                <tr>
                                    <td colspan="3" class="py-4 text-center text-gray-400 italic text-xs">No hay
                                        categorías registradas</td>
                                </tr>
                                <% } %>
                                    <% categorias.forEach(function(cat) { %>
                                        <tr>
                                            <td class="py-3 text-blue-600 font-bold text-xs">
                                                <%= cat.categoria %>
                                            </td>
                                            <td class="py-3 text-center text-gray-800 font-bold text-xs">
                                                <%= cat.creados %>
                                            </td>
                                            <td class="py-3 text-center text-green-600 font-bold text-xs">
                                                <%= cat.resueltos %>
                                            </td>
                                        </tr>
                                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
                <div class="flex items-center mb-6">
                    <span class="text-xl mr-2">🎫</span>
                    <h3 class="text-lg font-bold text-gray-800">Supervisión de Casos</h3>
                </div>

                <div class="flex gap-3 mb-4">
                    <input type="text" id="buscarTicket" placeholder="Buscar por solicitante, categoría o descripción..."
                        class="flex-1 border border-gray-300 rounded px-3 py-2 text-sm text-gray-700">
                    <select id="filtroEstado" class="border border-gray-300 rounded px-3 py-2 text-sm text-gray-700">
                        <option value="">Todos los estados</option>
                        <option value="abierto">Abierto</option>
                        <option value="solucionado">Solucionado</option>
                    </select>
                    <select id="filtroPrioridad" class="border border-gray-300 rounded px-3 py-2 text-sm text-gray-700">
                        <option value="">Todas las prioridades</option>
                        <option value="Baja">Baja</option>
                        <option value="Media">Media</option>
                        <option value="Alta">Alta</option>
                        <option value="Critica">Crítica</option>
                    </select>
                </div>

                <div id="barraLote"
                    class="hidden items-center gap-3 mb-4 bg-blue-50 border border-blue-200 rounded px-4 py-2">
                    <span id="loteContador" class="text-sm text-blue-700 font-bold"></span>
                    <button onclick="cerrarSeleccionados()"
                        class="bg-green-500 hover:bg-green-600 text-white text-xs px-3 py-1.5 rounded font-bold shadow">✔
                        Marcar Solucionado</button>
                    <button onclick="abrirModalAsignarLote()"
                        class="bg-blue-500 hover:bg-blue-600 text-white text-xs px-3 py-1.5 rounded font-bold shadow">🎯
                        Asignar técnico</button>
                    <button onclick="limpiarSeleccion()"
                        class="text-gray-500 hover:text-gray-700 text-xs font-bold ml-auto">Cancelar selección</button>
                </div>

                <table class="w-full border-collapse bg-gray-50 border border-gray-100 text-sm text-left">
                    <thead>
                        <tr>
                            <th class="border border-gray-200 px-3 py-2">
                                <input type="checkbox" id="checkAll" onchange="toggleSeleccionarTodos(this.checked)">
                            </th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                ID</th>
                            <th onclick="ordenarPor('fecha')"
                                class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase cursor-pointer select-none hover:bg-gray-100">
                                Fecha <span id="flecha-fecha"></span>
                            </th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Solicitante</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Categoría</th>
                            <th onclick="ordenarPor('prioridad')"
                                class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase cursor-pointer select-none hover:bg-gray-100">
                                Prioridad <span id="flecha-prioridad"></span>
                            </th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Descripción</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Técnico asignado</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Estado</th>
                            <th class="border border-gray-200 px-4 py-2 text-xs text-gray-600 font-bold uppercase">
                                Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white" id="ticketsAsignados">

                    </tbody>
                </table>
            </div>
        </div>

        <div id="modalAsignarTecnico" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
            <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm">
                <h3 class="text-lg font-bold text-gray-800 mb-1">Asignar técnico de soporte</h3>
                <p class="text-xs text-gray-500 mb-4">Ticket <span id="modalTicketId" class="font-bold"></span></p>
                <select id="selectTecnico"
                    class="w-full border border-gray-300 p-2 rounded text-sm text-gray-700 mb-4">
                    <option value="">Sin asignar</option>
                </select>
                <div class="flex justify-end space-x-2">
                    <button onclick="cerrarModalAsignar()"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs px-4 py-2 rounded font-bold">Cancelar</button>
                    <button onclick="confirmarAsignarTecnico()"
                        class="bg-blue-500 hover:bg-blue-600 text-white text-xs px-4 py-2 rounded font-bold">Guardar</button>
                </div>
            </div>
        </div>

        <script defer>
            const ticketsAsignados = document.querySelector('#ticketsAsignados');
            const buscarTicket = document.querySelector('#buscarTicket');
            const filtroEstado = document.querySelector('#filtroEstado');
            const filtroPrioridad = document.querySelector('#filtroPrioridad');

            let ticketsGerenteCache = [];
            let tecnicosMap = {};
            let ticketIdEnEdicion = null;
            let idsEnEdicionLote = null;
            const ticketsSeleccionados = new Set();

            function verDetalleTicket(id) {
                const ticket = ticketsGerenteCache.find(t => t.id === id);
                if (!ticket) return;
                const nombreTecnico = ticket.tecnico_asignado_id
                    ? (tecnicosMap[ticket.tecnico_asignado_id] || `Técnico #${ticket.tecnico_asignado_id}`)
                    : null;
                mostrarDetalleTicket(ticket, nombreTecnico);
            }

            function toggleSeleccion(id, marcado) {
                if (marcado) ticketsSeleccionados.add(id);
                else ticketsSeleccionados.delete(id);
                actualizarBarraLote();
            }

            function toggleSeleccionarTodos(marcado) {
                document.querySelectorAll('.ticket-checkbox').forEach(cb => {
                    cb.checked = marcado;
                    const id = Number(cb.value);
                    if (marcado) ticketsSeleccionados.add(id);
                    else ticketsSeleccionados.delete(id);
                });
                actualizarBarraLote();
            }

            function limpiarSeleccion() {
                ticketsSeleccionados.clear();
                document.querySelectorAll('.ticket-checkbox').forEach(cb => cb.checked = false);
                const checkAll = document.querySelector('#checkAll');
                if (checkAll) checkAll.checked = false;
                actualizarBarraLote();
            }

            function actualizarBarraLote() {
                const barra = document.querySelector('#barraLote');
                const contador = document.querySelector('#loteContador');
                if (ticketsSeleccionados.size > 0) {
                    barra.classList.remove('hidden');
                    barra.classList.add('flex');
                    contador.textContent = ticketsSeleccionados.size + ' ticket' + (ticketsSeleccionados.size === 1 ? '' : 's') + ' seleccionado' + (ticketsSeleccionados.size === 1 ? '' : 's');
                } else {
                    barra.classList.add('hidden');
                    barra.classList.remove('flex');
                }
            }

            async function cerrarSeleccionados() {
                if (ticketsSeleccionados.size === 0) return;
                const ids = [...ticketsSeleccionados];
                if (!(await confirmarAccion('¿Marcar ' + ids.length + ' ticket(s) como solucionado?'))) return;

                Promise.all(ids.map(id =>
                    fetch('/cambiarEstadoTicket', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id, cerrado: true })
                    })
                ))
                    .then(() => {
                        mostrarToast(ids.length + ' ticket(s) marcados como solucionados', 'exito');
                        limpiarSeleccion();
                        cargarTickets();
                    })
                    .catch(error => {
                        console.error('Error al cerrar tickets en lote:', error);
                        mostrarToast('Ocurrió un error al actualizar los tickets.', 'error');
                    });
            }

            function badgePrioridad(prioridad) {
                const estilos = {
                    Baja: 'bg-green-100 border-green-300 text-green-700',
                    Media: 'bg-yellow-100 border-yellow-300 text-yellow-700',
                    Alta: 'bg-orange-100 border-orange-300 text-orange-700',
                    Critica: 'bg-red-100 border-red-300 text-red-700',
                };
                const clase = estilos[prioridad] || estilos.Media;
                return `<span class="${clase} border px-2 py-1 rounded text-[10px] font-bold uppercase shadow-sm">${prioridad}</span>`;
            }

            function cargarTecnicos() {
                return fetch('/verTecnicosSoporte')
                    .then(response => response.json())
                    .then(tecnicos => {
                        tecnicosMap = {};
                        tecnicos.forEach(t => {
                            tecnicosMap[t.id] = `${t.nombre} ${t.apellido}`;
                        });

                        const select = document.querySelector('#selectTecnico');
                        select.innerHTML = '<option value="">Sin asignar</option>' +
                            tecnicos.map(t =>
                                `<option value="${t.id}">${t.nombre} ${t.apellido} (${t.categoriaAsignada || 'Sin categoría'})</option>`
                            ).join('');
                    })
                    .catch(error => console.error('Error al cargar técnicos:', error));
            }

            function cargarTickets() {
                ticketsAsignados.innerHTML = filaCargando(10);
                fetch('/verTickets')
                    .then(response => response.json())
                    .then(tickets => {
                        ticketsGerenteCache = tickets;
                        aplicarFiltros();
                    })
                    .catch(err => console.error('Error al cargar tickets:', err));
            }

            const RANGO_PRIORIDAD = { Baja: 1, Media: 2, Alta: 3, Critica: 4 };
            let sortColumna = null;
            let sortDireccion = 'asc';

            function ordenarPor(columna) {
                if (sortColumna === columna) {
                    sortDireccion = sortDireccion === 'asc' ? 'desc' : 'asc';
                } else {
                    sortColumna = columna;
                    sortDireccion = 'asc';
                }
                document.querySelectorAll('[id^="flecha-"]').forEach(el => el.textContent = '');
                const flecha = document.getElementById('flecha-' + columna);
                if (flecha) flecha.textContent = sortDireccion === 'asc' ? '▲' : '▼';
                aplicarFiltros();
            }

            function ordenarTickets(lista) {
                if (!sortColumna) return lista;
                const copia = [...lista];
                copia.sort((a, b) => {
                    let valA, valB;
                    if (sortColumna === 'fecha') {
                        valA = new Date(a.fecha_creacion).getTime();
                        valB = new Date(b.fecha_creacion).getTime();
                    } else if (sortColumna === 'prioridad') {
                        valA = RANGO_PRIORIDAD[a.prioridad] || 0;
                        valB = RANGO_PRIORIDAD[b.prioridad] || 0;
                    }
                    return sortDireccion === 'asc' ? valA - valB : valB - valA;
                });
                return copia;
            }

            function aplicarFiltros() {
                const texto = buscarTicket.value.trim().toLowerCase();
                const estado = filtroEstado.value;
                const prioridad = filtroPrioridad.value;

                const filtrados = ticketsGerenteCache.filter(t => {
                    const nombreTecnico = t.tecnico_asignado_id ? (tecnicosMap[t.tecnico_asignado_id] || '') : '';
                    const coincideTexto = !texto || t.usuario.toLowerCase().includes(texto) || t.nombre.toLowerCase().includes(texto) || t.descripcion.toLowerCase().includes(texto) || nombreTecnico.toLowerCase().includes(texto);
                    const coincideEstado = !estado || (estado === 'solucionado' ? !!t.fecha_cierre : !t.fecha_cierre);
                    const coincidePrioridad = !prioridad || t.prioridad === prioridad;
                    return coincideTexto && coincideEstado && coincidePrioridad;
                });

                pintarTickets(ordenarTickets(filtrados));
            }

            [buscarTicket, filtroEstado, filtroPrioridad].forEach(el => {
                el.addEventListener('input', aplicarFiltros);
                el.addEventListener('change', aplicarFiltros);
            });

            function pintarTickets(tickets) {
                ticketsAsignados.innerHTML = '';

                if (tickets.length === 0) {
                    ticketsAsignados.innerHTML = `<tr><td colspan="10" class="border border-gray-200 px-4 py-8 text-center text-gray-500 italic">No se encontraron tickets con esos filtros</td></tr>`;
                    return;
                }

                tickets.forEach(ticket => {
                    const fecha = new Date(ticket.fecha_creacion).toLocaleDateString('es-ES');
                    const tecnicoTexto = ticket.tecnico_asignado_id
                        ? (tecnicosMap[ticket.tecnico_asignado_id] || `Técnico #${ticket.tecnico_asignado_id}`)
                        : 'Sin asignar';

                    const estado = ticket.fecha_cierre ?
                        `<span class="bg-green-100 border border-green-300 text-green-700 px-2 py-1 rounded text-[10px] font-bold uppercase shadow-sm">SOLUCIONADO</span>` :
                        `<span class="bg-yellow-100 border border-yellow-300 text-yellow-700 px-2 py-1 rounded text-[10px] font-bold uppercase shadow-sm">ABIERTO</span>`;

                    const acciones = `
                        <div class="flex flex-col space-y-1 w-28">
                            <button onclick="verDetalleTicket(${ticket.id})"
                                class="bg-slate-500 hover:bg-slate-600 text-white text-[10px] px-1 py-1 rounded font-bold shadow">👁️ Ver</button>
                            <button onclick="abrirModalAsignar('${ticket.id}')"
                                class="bg-blue-500 hover:bg-blue-600 text-white text-[10px] px-1 py-1 rounded font-bold shadow">🎯 Asignar</button>
                            ${ticket.fecha_cierre
                            ? `<button onclick="reabrirTicket('${ticket.id}')" class="bg-gray-400 hover:bg-gray-500 text-white text-[10px] px-1 py-1 rounded font-bold shadow">↺ Reabrir</button>`
                            : `<button onclick="cerrarTicket('${ticket.id}')" class="bg-green-500 hover:bg-green-600 text-white text-[10px] px-1 py-1 rounded font-bold shadow">✔ Solucionado</button>`}
                        </div>
                    `;

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="border border-gray-200 px-3 py-3 text-center">
                            <input type="checkbox" class="ticket-checkbox" value="${ticket.id}" ${ticketsSeleccionados.has(ticket.id) ? 'checked' : ''} onchange="toggleSeleccion(${ticket.id}, this.checked)">
                        </td>
                        <td class="border border-gray-200 px-4 py-3 font-bold text-gray-800 text-xs">t-${ticket.id}</td>
                        <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${fecha}</td>
                        <td class="border border-gray-200 px-4 py-3 text-gray-800 text-xs">${ticket.usuario}</td>
                        <td class="border border-gray-200 px-4 py-3 text-blue-600 font-bold text-xs">${ticket.nombre}</td>
                        <td class="border border-gray-200 px-4 py-3">${badgePrioridad(ticket.prioridad)}</td>
                        <td class="border border-gray-200 px-4 py-3 text-gray-800 text-xs">${ticket.descripcion}${ticket.adjunto ? ` <a href="${ticket.adjunto}" target="_blank" class="text-blue-500 underline">📎</a>` : ''}</td>
                        <td class="border border-gray-200 px-4 py-3 text-gray-600 text-xs">${tecnicoTexto}</td>
                        <td class="border border-gray-200 px-4 py-3">${estado}</td>
                        <td class="border border-gray-200 px-4 py-3">${acciones}</td>
                    `;
                    ticketsAsignados.appendChild(tr);
                });
            }

            function abrirModalAsignar(id) {
                ticketIdEnEdicion = id;
                idsEnEdicionLote = null;
                document.querySelector('#modalTicketId').textContent = 't-' + id;
                document.querySelector('#modalAsignarTecnico').classList.remove('hidden');
                document.querySelector('#modalAsignarTecnico').classList.add('flex');
            }

            function abrirModalAsignarLote() {
                if (ticketsSeleccionados.size === 0) return;
                idsEnEdicionLote = [...ticketsSeleccionados];
                ticketIdEnEdicion = null;
                document.querySelector('#modalTicketId').textContent = idsEnEdicionLote.length + ' tickets seleccionados';
                document.querySelector('#modalAsignarTecnico').classList.remove('hidden');
                document.querySelector('#modalAsignarTecnico').classList.add('flex');
            }

            function cerrarModalAsignar() {
                document.querySelector('#modalAsignarTecnico').classList.add('hidden');
                document.querySelector('#modalAsignarTecnico').classList.remove('flex');
                ticketIdEnEdicion = null;
                idsEnEdicionLote = null;
            }

            function confirmarAsignarTecnico() {
                const tecnicoId = document.querySelector('#selectTecnico').value;
                const tecnico_asignado_id = tecnicoId ? Number(tecnicoId) : null;
                const ids = idsEnEdicionLote || [ticketIdEnEdicion];

                Promise.all(ids.map(id =>
                    fetch('/asignarTecnico', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id, tecnico_asignado_id })
                    }).then(response => response.json())
                ))
                    .then(() => {
                        mostrarToast(ids.length > 1 ? 'Técnico asignado a ' + ids.length + ' tickets' : 'Técnico asignado correctamente', 'exito');
                        cerrarModalAsignar();
                        limpiarSeleccion();
                        cargarTickets();
                    })
                    .catch(error => {
                        console.error('Error al asignar técnico:', error);
                        mostrarToast('Ocurrió un error al asignar el técnico.', 'error');
                    });
            }

            async function cerrarTicket(id) {
                if (!(await confirmarAccion('¿Marcar el ticket t-' + id + ' como solucionado?'))) return;
                cambiarEstado(id, true);
            }

            async function reabrirTicket(id) {
                if (!(await confirmarAccion('¿Reabrir el ticket t-' + id + '?'))) return;
                cambiarEstado(id, false);
            }

            function cambiarEstado(id, cerrado) {
                fetch('/cambiarEstadoTicket', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, cerrado })
                })
                    .then(response => response.json())
                    .then(data => {
                        mostrarToast(cerrado ? 'Ticket marcado como solucionado' : 'Ticket reabierto', 'exito');
                        cargarTickets();
                    })
                    .catch(error => {
                        console.error('Error al cambiar estado del ticket:', error);
                        mostrarToast('Ocurrió un error al actualizar el ticket.', 'error');
                    });
            }

            cargarTecnicos().then(cargarTickets);
        </script>
    </body>

    </html>