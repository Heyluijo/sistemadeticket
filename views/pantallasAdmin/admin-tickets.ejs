<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrar Tickets</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex h-screen font-sans">

    <%- include('../partials/menuLateral.ejs', { activeTab: 'tickets' }) %>

        <div class="flex-1 p-8 overflow-y-auto">
            <div class="mb-8 border-b border-gray-300 pb-4">
                <h2 class="text-3xl font-bold text-gray-800 mb-1">Administrar Tickets</h2>
                <p class="text-gray-500 text-sm">Ver historial completo de soporte, cambiar estados y asignar soporte
                </p>
            </div>

            <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm mb-8">
                <div class="flex items-center mb-6">
                    <span class="text-xl mr-2">🎫</span>
                    <h3 class="text-lg font-bold text-gray-800">Historial Global</h3>
                </div>

                <table class="w-full border-collapse border border-gray-100 text-sm text-left">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">ID
                            </th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">FECHA
                            </th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                SOLICITANTE
                            </th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                CATEGORIAS
                            </th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                PRIORIDAD
                            </th>

                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                DESCRIPCION</th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                SOPORTE
                                TÉCNICO</th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                ESTADO
                            </th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                ACCIONES
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tablaTicketsAdmin">
                        <!-- Cargado dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>

        <div id="modalAsignarTecnico" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
            <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm">
                <h3 class="text-lg font-bold text-gray-800 mb-1">Asignar técnico de soporte</h3>
                <p class="text-xs text-gray-500 mb-4">Ticket <span id="modalTicketId" class="font-bold"></span></p>
                <select id="selectTecnico"
                    class="w-full border border-gray-300 p-2 rounded text-sm text-gray-700 mb-4">
                    <option value="">Sin asignar</option>
                </select>
                <div class="flex justify-end space-x-2">
                    <button onclick="cerrarModalAsignar()"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs px-4 py-2 rounded font-bold">Cancelar</button>
                    <button onclick="confirmarAsignarTecnico()"
                        class="bg-blue-500 hover:bg-blue-600 text-white text-xs px-4 py-2 rounded font-bold">Guardar</button>
                </div>
            </div>
        </div>

        <script>
            let ticketIdEnEdicion = null;
            let tecnicosMap = {};

            document.addEventListener('DOMContentLoaded', () => {
                cargarTecnicos().then(cargarTickets);
            });

            function cargarTecnicos() {
                return fetch('/verTecnicosSoporte')
                    .then(response => response.json())
                    .then(tecnicos => {
                        tecnicosMap = {};
                        tecnicos.forEach(t => {
                            tecnicosMap[t.id] = `${t.nombre} ${t.apellido}`;
                        });

                        const select = document.querySelector('#selectTecnico');
                        select.innerHTML = '<option value="">Sin asignar</option>' +
                            tecnicos.map(t =>
                                `<option value="${t.id}">${t.nombre} ${t.apellido} (${t.categoriaAsignada || 'Sin categoría'})</option>`
                            ).join('');
                    })
                    .catch(error => console.error('Error al cargar técnicos:', error));
            }

            function editarTicket(id) {
                ticketIdEnEdicion = id;
                document.querySelector('#modalTicketId').textContent = 't-' + id;
                document.querySelector('#modalAsignarTecnico').classList.remove('hidden');
                document.querySelector('#modalAsignarTecnico').classList.add('flex');
            }

            function cerrarModalAsignar() {
                document.querySelector('#modalAsignarTecnico').classList.add('hidden');
                document.querySelector('#modalAsignarTecnico').classList.remove('flex');
                ticketIdEnEdicion = null;
            }

            function confirmarAsignarTecnico() {
                const tecnicoId = document.querySelector('#selectTecnico').value;

                fetch('/asignarTecnico', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: ticketIdEnEdicion,
                        tecnico_asignado_id: tecnicoId ? Number(tecnicoId) : null
                    })
                })
                    .then(response => response.json())
                    .then(data => {
                        alert(data.message);
                        cerrarModalAsignar();
                        cargarTickets();
                    })
                    .catch(error => {
                        console.error('Error al asignar técnico:', error);
                        alert('Ocurrió un error al asignar el técnico.');
                    });
            }

            function badgePrioridad(prioridad) {
                const estilos = {
                    Baja: 'bg-green-100 border-green-300 text-green-700',
                    Media: 'bg-yellow-100 border-yellow-300 text-yellow-700',
                    Alta: 'bg-orange-100 border-orange-300 text-orange-700',
                    Critica: 'bg-red-100 border-red-300 text-red-700',
                };
                const clase = estilos[prioridad] || estilos.Media;
                return `<span class="${clase} border px-2 py-1 rounded text-[10px] font-bold uppercase shadow-sm">${prioridad}</span>`;
            }

            function cargarTickets() {
                fetch('/verTickets')
                    .then(response => response.json())
                    .then(tickets => {
                        const tabla = document.querySelector('#tablaTicketsAdmin');
                        tabla.innerHTML = '';

                        tickets.forEach(t => {
                            const fecha = new Date(t.fecha_creacion).toLocaleDateString('es-ES');
                            const fechaCierre = t.fecha_cierre ? new Date(t.fecha_cierre).toLocaleDateString('es-ES') : '-';

                            // Texto de estado
                            let estadoTexto = '';
                            let estadoClass = '';
                            if (t.fecha_cierre) {
                                estadoTexto = 'SOLUCIONADO';
                                estadoClass = 'bg-green-100 border-green-300 text-green-700';
                            } else {
                                estadoTexto = 'ABIERTO';
                                estadoClass = 'bg-yellow-100 border-yellow-300 text-yellow-700';
                            }

                            // Soporte técnico
                            let soporteTexto = t.tecnico_asignado_id
                                ? (tecnicosMap[t.tecnico_asignado_id] || `Técnico #${t.tecnico_asignado_id}`)
                                : 'Sin asignar';

                            // Botones de acción
                            let acciones = `
                                <div class="flex flex-col space-y-1 w-16">
                                    <button 
                                        onclick="editarTicket('${t.id}')"
                                        class="bg-yellow-500 hover:bg-yellow-600 text-white text-[10px] px-1 py-1 rounded flex items-center justify-center font-bold shadow">
                                        <span class="mr-1">✏️</span> Editar
                                    </button>
                                    <button 
                                        onclick="borrarTicket('${t.id}')"
                                        class="bg-red-500 hover:bg-red-600 text-white text-[10px] px-1 py-1 rounded flex items-center justify-center font-bold shadow">
                                        <span class="mr-1">🗑️</span> Borrar
                                    </button>
                                </div>
                            `;

                            const fila = document.createElement('tr');
                            fila.innerHTML = `
                                <td class="border border-gray-200 px-4 py-4 font-bold text-gray-800">t-${t.id}</td>
                                <td class="border border-gray-200 px-4 py-4 text-gray-600 text-xs">${fecha}</td>
                                <td class="border border-gray-200 px-4 py-4">
                                    <p class="font-bold text-gray-800 text-xs">${t.usuario}</p>
                                </td>
                                <td class="border border-gray-200 px-4 py-4">
                                    <p class="font-bold text-gray-800 text-xs">${t.nombre}</p>
                                </td>
                                <td class="border border-gray-200 px-4 py-4">
                                    ${badgePrioridad(t.prioridad)}
                                </td>

                                <td class="border border-gray-200 px-4 py-4 text-gray-800 text-xs font-bold">
                                    ${t.descripcion.substring(0, 30)}...
                                </td>
                                <td class="border border-gray-200 px-4 py-4 text-gray-600 text-xs">
                                    ${soporteTexto}
                                </td>
                                <td class="border border-gray-200 px-4 py-4">
                                    <span class="bg-yellow-100 border border-yellow-300 text-yellow-700 px-2 py-1 rounded text-xs font-bold uppercase shadow-sm">
                                        ${estadoTexto}
                                    </span>
                                </td>
                                <td class="border border-gray-200 px-4 py-4">
                                    ${acciones}
                                </td>
                            `;
                            tabla.appendChild(fila);
                        });
                    });
            }

            function borrarTicket(id) {
                if (confirm('¿Estás seguro de que quieres borrar el ticket ' + id + '?')) {
                    fetch('/delete-ticket/' + id, { method: 'DELETE' })
                        .then(response => response.json())
                        .then(data => {
                            alert(data.message);
                            cargarTickets();
                        })
                        .catch(err => console.error(err));
                }
            }
        </script>

</body>

</html>