<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrar Categorías</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex h-screen font-sans">

    <%- include('../partials/menuLateral.ejs', { activeTab: 'categorias' }) %>

        <div class="flex-1 p-8 overflow-y-auto">
            <div class="flex justify-between items-center mb-8 border-b border-gray-300 pb-4">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800 mb-1">Administrar Categorías</h2>
                    <p class="text-gray-500 text-sm">Configura clasificaciones y enlaces automáticos a técnicos</p>
                </div>
                <button
                    class="bg-blue-500 hover:bg-blue-600 text-white text-sm px-4 py-2 rounded shadow font-bold flex items-center">
                    <span class="mr-2 text-lg">+</span> Nueva Categoría
                </button>
            </div>

            <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm mb-8">
                <div class="flex items-center mb-6">
                    <span class="text-xl mr-2">🏷️</span>
                    <h3 class="text-lg font-bold text-gray-800">Listado de Categorías</h3>
                </div>

                <table class="w-full border-collapse border border-gray-100 text-sm text-left">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                NOMBRE
                            </th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                DESCRIPCIÓN</th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                TÉCNICO
                                AUTOMÁTICO</th>
                            <th class="border border-gray-200 px-4 py-3 text-xs text-gray-600 font-bold uppercase">
                                ACCIONES
                            </th>
                        </tr>
                    </thead>
                    <tbody id="listadoCategorias">

                    </tbody>
                </table>
            </div>
        </div>
        <script>
            const listadoCategorias = document.querySelector('#listadoCategorias');

            fetch('/verUsuariosAsignados')
                .then(response => response.json())
                .then(usuarios => {
                    listadoCategorias.innerHTML = '';
                    usuarios.forEach(usuario => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="border border-gray-200 px-4 py-4 text-blue-600 font-bold w-48">${usuario.nombre}</td>
                            <td class="border border-gray-200 px-4 py-4 text-gray-600 text-xs">${usuario.categoria}</td>
                            <td class="border border-gray-200 px-4 py-4 text-green-700 font-bold text-xs">${usuario.descripcion}</td>
                            <td class="border border-gray-200 px-4 py-4">
                                <div class="flex flex-col space-y-2 w-20">
                                    <button
                                        class="bg-yellow-500 hover:bg-yellow-600 text-white text-xs px-2 py-1 rounded flex items-center justify-center font-bold shadow">
                                        <span class="mr-1 text-sm">✏️</span> Editar
                                    </button>
                                    <button
                                        class="bg-red-500 hover:bg-red-600 text-white text-xs px-2 py-1 rounded flex items-center justify-center font-bold shadow">
                                        <span class="mr-1 text-sm">🗑️</span> Borrar
                                    </button>
                                </div>
                            </td>
                        `;
                        listadoCategorias.appendChild(tr);
                    });
                })
                .catch(err => console.error('Error al cargar categorías:', err));
        </script>
</body>

</html>